{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": ["${mod_author}"],
  "license": "${mod_license}",
  "contact": {
    "sources": "${mod_source_url}",
    "issues": "${mod_source_url}/issues"
  },
  "icon": "assets/confee/img/ConfeeIconPromo-2.png",
  "environment": "*",
  "entrypoints": {
    "main": ["fr.heetstudio.confee.fabric.ConfeeFabric"],
    "client": ["fr.heetstudio.confee.fabric.ConfeeFabricClient"],
    "modmenu": ["fr.heetstudio.confee.fabric.ConfeeModMenu"]
  },
  "mixins": ["confee.mixins.json"],
  "depends": {
    "fabricloader": ">=${fabric_loader_min_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version_range_fabric}",
    "java": ">=25"
  },
  "suggests": {
    "modmenu": "*"
  }
}
