# Copy this file to .env and fill in the tokens. .env is ignored by Git: never commit it.

# Modrinth personal access token, with the "Create versions" scope (Settings > PATs)
MODRINTH_TOKEN="..."

# CurseForge API token (authors.curseforge.com > API Tokens)
CURSEFORGE_TOKEN="..."

# "true" publishes for real; anything else (or unset) is a dry run
CONFEE_PUBLISH="false"

# Optional: override the project IDs from gradle.properties
# MODRINTH_PROJECT_ID="itTlrYl0"
# CURSEFORGE_PROJECT_ID="1817213"
